# Foxit PDF Services credentials from https://app.developer-api.foxit.com/
FOXIT_CLOUD_API_HOST=https://na1.fusion.foxit.com/pdf-services
FOXIT_CLOUD_API_CLIENT_ID=replace_with_pdf_services_client_id
FOXIT_CLOUD_API_CLIENT_SECRET=replace_with_pdf_services_client_secret

# Absolute path to the Python implementation inside the official Foxit MCP clone.
# Example: /home/you/src/foxit-pdf-api-mcp-server/python/foxit-pdf-api-mcp-server
FOXIT_PDF_MCP_DIRECTORY=/absolute/path/to/foxit-pdf-api-mcp-server/python/foxit-pdf-api-mcp-server

# Foxit eSign credentials from the separate eSign portal/API settings.
# Change the base URL if your eSign account uses another Foxit region.
FOXIT_ESIGN_BASE_URL=https://na1.foxitesign.foxit.com
FOXIT_ESIGN_CLIENT_ID=replace_with_esign_client_id
FOXIT_ESIGN_CLIENT_SECRET=replace_with_esign_client_secret

# Manual eSign spike recipient. Use a consenting recipient with an inbox you control.
FOXIT_ESIGN_RECIPIENT_EMAIL=signer@example.com
FOXIT_ESIGN_RECIPIENT_FIRST_NAME=Test
FOXIT_ESIGN_RECIPIENT_LAST_NAME=Signer

# Required safety latch for both the manual script and Phase 5 web approval action.
# A checked browser confirmation is also required for every web send.
FOXIT_ESIGN_CONFIRM_SEND=NO

# Artifact generated by the PDF spike and consumed by the eSign spike.
CLAIMGATE_PHASE0_PDF=artifacts/phase0-agreement.pdf

# Artifact generated and re-extracted by the legacy deterministic CLI workflow.
CLAIMGATE_PHASE2_PDF=artifacts/phase2-agreement.pdf

# ClaimGate defaults to its deterministic scripted semantic provider. To make live
# LLM calls, select openai and set an API key plus a Responses model that supports
# Structured Outputs. The semantic provider has no tools and cannot approve signing.
CLAIMGATE_SEMANTIC_PROVIDER=scripted
OPENAI_API_KEY=replace_with_openai_api_key
CLAIMGATE_OPENAI_MODEL=replace_with_structured_outputs_model
OPENAI_BASE_URL=https://api.openai.com/v1

# Public-evidence discovery defaults to deterministic scripted results.
# Select serpapi for live backend-only Google organic-result discovery. The browser
# never receives this key or arbitrary search-engine controls.
CLAIMGATE_PUBLIC_EVIDENCE_PROVIDER=scripted
SERPAPI_API_KEY=replace_with_serpapi_api_key

# Artifact generated and re-extracted by the semantic verification CLI workflow.
CLAIMGATE_PHASE3_PDF=artifacts/phase3-agreement.pdf

# Local FastAPI application. Keep the default loopback host unless intentionally
# demonstrating from another device on a trusted network.
CLAIMGATE_WEB_HOST=127.0.0.1
CLAIMGATE_WEB_PORT=8000
CLAIMGATE_WEB_ARTIFACT_DIRECTORY=artifacts/web
