<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>ClaimGate Decision Receipt</title>
  <style>
    @page { size: A4; margin: 18mm; }
    body { color: #17202a; font: 11px/1.45 Arial, sans-serif; }
    h1 { margin: 0; font-size: 25px; }
    h2 { margin: 20px 0 8px; font-size: 14px; }
    .notice { margin: 8px 0 18px; color: #56616d; }
    .decision { margin: 14px 0; padding: 12px; border: 2px solid #263746; font-size: 20px; font-weight: bold; }
    table { width: 100%; border-collapse: collapse; }
    th, td { padding: 6px; border: 1px solid #cbd2d8; text-align: left; vertical-align: top; }
    th { background: #edf1f4; }
    code { font: 9px/1.4 monospace; overflow-wrap: anywhere; }
    ul { margin: 6px 0; padding-left: 20px; }
  </style>
</head>
<body>
  <h1>ClaimGate Decision Receipt</h1>
  <p class="notice">
    Human-readable rendering only. The canonical JSON receipt and its SHA-256 are authoritative.
  </p>
  <div class="decision">{{ receipt.final_decision.value }}</div>

  <table>
    <tr><th>Run</th><td>{{ receipt.run_id }}</td></tr>
    <tr><th>Workflow state</th><td>{{ receipt.workflow_state.value }}</td></tr>
    <tr><th>Created</th><td>{{ receipt.created_at.isoformat() }}</td></tr>
    <tr><th>PDF SHA-256</th><td><code>{{ receipt.pdf_sha256 }}</code></td></tr>
    <tr><th>Evidence SHA-256</th><td><code>{{ receipt.evidence.evidence_sha256 }}</code></td></tr>
    <tr><th>Baseline policy</th><td>{{ receipt.policy.baseline_policy_version }}</td></tr>
    <tr><th>Policy profile</th><td>{{ receipt.policy.policy_profile_id }}</td></tr>
    <tr><th>Profile SHA-256</th><td><code>{{ receipt.policy.policy_profile_sha256 }}</code></td></tr>
    <tr><th>Approval</th><td>{{ "APPROVED" if receipt.approval.occurred else "NOT APPROVED" }}</td></tr>
    <tr><th>eSign</th><td>{{ receipt.esign.status.value }}{% if receipt.esign.foxit_identifier %} — {{ receipt.esign.foxit_identifier }}{% endif %}</td></tr>
    <tr><th>Receipt SHA-256</th><td><code>{{ receipt.receipt_sha256 }}</code></td></tr>
  </table>

  {% if receipt.evidence.public_sources %}
  <h2>Public evidence provenance</h2>
  <table>
    <thead><tr><th>Source</th><th>Trust</th><th>Provider / retrieval</th></tr></thead>
    <tbody>
      {% for source in receipt.evidence.public_sources %}
      <tr>
        <td>{{ source.source_id }}<br><code>{{ source.source_url }}</code></td>
        <td>{{ source.authority.value }}<br>{{ source.source_type.value }}</td>
        <td>{{ source.provider }} · {{ source.domain }}<br>{{ source.retrieved_at.isoformat() }}<br>Query: {{ source.query }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% endif %}

  <h2>Claims</h2>
  <table>
    <thead><tr><th>Category</th><th>Value</th><th>Status</th><th>Sources</th></tr></thead>
    <tbody>
      {% for claim in receipt.claims %}
      <tr>
        <td>{{ claim.category.value }}{% if claim.critical %} · critical{% endif %}</td>
        <td>{{ claim.normalized_value }}</td>
        <td>{{ claim.verification_status.value }}</td>
        <td>
          Supports: {{ claim.supporting_source_ids | join(", ") or "none" }}<br>
          Conflicts: {{ claim.conflicting_source_ids | join(", ") or "none" }}
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <h2>Blockers</h2>
  {% if receipt.blocker_codes %}
  <ul>{% for code in receipt.blocker_codes %}<li>{{ code }}</li>{% endfor %}</ul>
  {% else %}<p>None.</p>{% endif %}

  {% if receipt.previous_receipt_sha256 %}
  <h2>Previous receipt</h2>
  <code>{{ receipt.previous_receipt_sha256 }}</code>
  {% endif %}
</body>
</html>
